; <<<< Manual test of piano.o >>>>

      ORG &0100
      ENT start

      IMPORT "const.i"
      IMPORT "piano.o"
      IMPORT "testlib.o"

; 2025         
; --- 0.0an ---
  ; Aug 25 Api update 
         ; Use testlib
; 2024
; ------- AyAne 0.0v -------
  ; Set 30  Fix instr setting (must use fx addresses)

      MACRO VOL n
; Encode as expected -> xxxx0
      BYTE n*2
      ENDM

start
; --- Firmware setup ---
          ld a,2:call &BC0E

; --- For dev test ---
          call init_for_test
;          call dummy_instr
          call dummy_instr_ui

          ld a,3*12:ld (octave_shift),a

; ------ Main loop
.loop
          call &BB06
          cp &FC
          ret z         ; EXIT with break
          call is_piano_key_pressed
          jr nc,.loop
          call play_piano
          jr .loop

