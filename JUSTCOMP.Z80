; Pilotage compilation 

; 2026 Out 27 Compile from .aya (instead of .chp)
            ; (more versatile, e.g. we might adjust .aya)
            ; Use common memmap:
                 ; - doesn't fit in memory otherwise?
                 ; - easier to debug
                 ; - CON: cannot return to BASIC

; 2025 Mar 27 Based sur compnrt

      IMPORT "memmap.i"
      IMPORT "import.i"
      IMPORT "plyconf.i" ; just for check below 
      IF 1-ayane
 !! Compile: in-tool routine, so ayane must be set.
      END

save_filename = tmp_filename + 64

scr_set_border = &BC38
disc_out_direct = &BC98

      ORG code_start
      ENT do_compile

          IMPORT_SALO_DEPS()

      ORG init_module

      IMPORT "init.o"
;      IMPORT "track.o"  ; for monitor 
      IMPORT "assert.o"
      IMPORT "memcpc.o"
;     IMPORT "testlib.o"

; ------------------------------
hi
      SKIP &4000-$      ; poor man's limit

      ORG salo
      IMPORT "salo.o"
      IMPORT "compile.o"

;data  = compiled_data

do_compile
          ld a,&F7:ld (0),a
;-- load
          call full_init
          ld hl,tmp_filename
          ld bc,0       ; skip metadata
          call load_file
          call nc,mess
;-- compile
          call compile
          ld (data_start),de
          ld (data_size),hl
;-- save 
          ld hl,save_filename
          call get_text_len
          ld de,disc_buffer
          call disc_out_open
          ld a,fail_opening:call nc,mess

          ld hl,(data_start)
          ld de,(data_size)
          ld bc,0
          ld a,2        ; binary
          call disc_out_direct
          call nc,mess
          call disc_out_close ; exit ok

          ld bc,&1212:call scr_set_border
          call &BB06
          ret           ; will crash on basic return

; ------------------------------

data_start WORD 0
data_size WORD 0

      SKIP ramlimit' - $




